{
  "manifest_version": 3,
  "name": "Job-auto 职位采集与网申回填助手",
  "version": "1.3.0",
  "description": "配合 Job-auto 统一工作台/本地接收器，自动下拉采集 Boss直聘 / 智联招聘 / 51job / 国聘网 / 实习僧，并安全读取本机档案与QA一键填充网申表单（只填不提交）。",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://*.zhipin.com/*",
    "https://*.zhaopin.com/*",
    "https://*.51job.com/*",
    "https://*.iguopin.com/*",
    "https://*.shixiseng.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job-auto 自动下拉采集"
  }
}
