# 复制为本地 .env（.env 已被 .gitignore 屏蔽，绝不可提交到 Git）
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# 可选：若启用备用 OpenAI-compatible 模型通道
# FALLBACK_LLM_API_KEY=

# 可选：使用 QQ 邮箱 / 163 邮箱发送每日 HTML 求职简报
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your_qq@qq.com
# SMTP_PASS=your_16_char_smtp_auth_code

# 可选：额外加载外部未打包浏览器扩展（多路径用英文逗号或分号分隔）
# JOB_AUTO_EXTRA_EXTENSIONS=

# 可选：若启用飞书审批通知插件
# FEISHU_WEBHOOK_URL=
